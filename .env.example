# Copy to .env and fill in. Never commit .env.
APP_ENV=development            # development | production | testing
SECRET_KEY=change-me-use-python-c-"import secrets;print(secrets.token_hex(32))"
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVICE_CREDENTIAL_KEY=
DEVICE_SYNC_MAX_RECORDS=5000
DATABASE_URL=postgresql+psycopg://gym:CHANGE_ME@127.0.0.1:5432/gym
TEST_DATABASE_URL=postgresql+psycopg://gym:CHANGE_ME@127.0.0.1:5432/gym_test
POSTGRES_PASSWORD=CHANGE_ME     # used by docker-compose.yml

GYM_NAME=My Gym
GYM_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR

# Access policy for members with unpaid dues: allow | require_partial | require_full
DUES_POLICY=require_partial
EXPIRY_WARNING_DAYS=7
LONG_SESSION_HOURS=6
SESSION_IDLE_MINUTES=120

# Production only
FORCE_HTTPS=false              # set true behind TLS
TRUSTED_PROXY_COUNT=0          # number of reverse proxies in front (for client IP / scheme)
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
